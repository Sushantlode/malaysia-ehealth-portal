{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/TATA_postgres/:path*",
      "destination": "/api/tata-postgres/:path*"
    },
    {
      "source": "/hims-ui",
      "destination": "/hims-ui/index.html"
    },
    {
      "source": "/hims-ui/:path*",
      "destination": "http://15.252.193.15:8080/hims-ui/:path*"
    }
  ]
}
